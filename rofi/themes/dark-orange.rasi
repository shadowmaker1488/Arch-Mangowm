/* Dark Orange Rounded Theme for Rofi */
/* Based on Newman Sanchez rounded theme + screenshot colors */
/* Selected / context highlight = dark orange */

* {
    font:   "Roboto 14";

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       north;
    y-offset:       calc(50% - 176px);
    width:          600;
    border-radius:  24px;

    background-color:   @bg0;
}

mainbox {
    padding:    12px;
}

inputbar {
    background-color:   @bg1;
    border-color:       @bg3;           /* dark orange border on search */

    border:         2px;
    border-radius:  16px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @fg2;
}


message {
    margin:             12px 0 0;
    border-radius:      16px;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    margin:     12px 0 0;
    lines:      8;
    columns:    2;                      /* dvě řady (sloupce) */

    fixed-height: false;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  16px;
}

element normal active {
    text-color: @bg3;
}

element alternate active {
    text-color: @bg3;
}

/* Selected item – tmavě oranžové kontextové menu */
element selected normal,
element selected active {
    background-color:   @bg3;           /* dark orange */
    text-color:         @fg1;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}

/* ========== COLORS ========== */
* {
    bg0:    #0a0a0aF2;      /* almost black, slightly transparent */
    bg1:    #161616;        /* search bar background */
    bg2:    #22222280;      /* message background */
    bg3:    #A04000;        /* dark orange – selected / accent */
    fg0:    #E6E6E6;        /* main text */
    fg1:    #FFFFFF;        /* selected text (white on orange) */
    fg2:    #969696;        /* dim / placeholder */
    fg3:    #3D3D3D;
}
